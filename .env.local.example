# Copiá este archivo a .env.local y completá con los datos de tu proyecto Supabase
# (Project Settings -> API en el dashboard de Supabase)

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anonima-publica

# --- Opcional: reconocimiento visual real con IA (ver README, sección 2.2) ---
# Sin esto, el matching sigue funcionando con comparación de color.
HUGGINGFACE_API_TOKEN=

# --- Opcional: mapa interactivo con pin (ver README, sección 2.3) ---
# Sin esto, se puede seguir usando el botón "Usar mi ubicación".
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Opcional: notificaciones push del navegador para coincidencias ---
# Sin esto, el botón "Avisame acá si hay una coincidencia" no aparece, y el
# aviso por email sigue funcionando igual. Ver PENDIENTE_DECISION.md para
# cómo generar estas claves (no requiere ninguna cuenta de terceros).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-email@ejemplo.com
