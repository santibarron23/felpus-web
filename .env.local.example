# Copiá este archivo a .env.local y completá con los datos de tu proyecto Supabase
# (Project Settings -> API en el dashboard de Supabase)

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anonima-publica

# --- Requerido: ver contacto / denunciar / publicar (rate limiting real) ---
# La service role key de tu proyecto (Project Settings -> API -> "service_role",
# la que dice "secret" al lado). NUNCA la pongas en una variable NEXT_PUBLIC_
# ni la subas al repo — solo la usan las rutas de servidor (src/app/api/*),
# nunca el navegador. Sin esto, ver el contacto de una publicación y
# denunciar dejan de funcionar (devuelven 501) — ver PENDIENTE_DECISION.md
# #-14 para el detalle completo de por qué se movió detrás del servidor.
SUPABASE_SERVICE_ROLE_KEY=

# Mapas: OpenStreetMap, no necesitan key (ver README, sección 2.3).

# --- Opcional: login con Google embebido en la página (sin redirect) ---
# Sin esto, "Acceder con Google" sigue funcionando igual que siempre con el
# flujo clásico (signInWithOAuth), que rebota por el dominio propio del
# proyecto de Supabase antes de volver a la app. Con esta variable
# configurada, Google muestra el dominio real (felpus.com) en vez del de
# Supabase. Ver PENDIENTE_DECISION.md para el detalle completo y el paso
# adicional que hace falta en el Dashboard de Supabase.
#
# Es el mismo Client ID que ya usás para el login de Google (Google Cloud
# Console -> Credentials -> tu OAuth 2.0 Client ID -> "Client ID", termina
# en ".apps.googleusercontent.com"). NO es un valor secreto — es información
# pública que igual viaja en cada pedido de login, por eso puede ir en una
# variable NEXT_PUBLIC_.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Opcional: notificaciones push del navegador para coincidencias ---
# Sin esto, el botón "Avisame acá si hay una coincidencia" no aparece, y el
# aviso por email sigue funcionando igual. Ver PENDIENTE_DECISION.md para
# cómo generar estas claves (no requiere ninguna cuenta de terceros).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-email@ejemplo.com

# --- Opcional: email de "posible coincidencia" (webhook /api/notify-match) ---
# Sin esto, el webhook responde 501 y no manda nada — no rompe la
# publicación de reportes, solo ese aviso puntual. Ver PENDIENTE_DECISION.md
# para el paso a paso completo (crear cuenta gratis en Resend, y guardar el
# secreto del webhook en Supabase Vault, no acá).
RESEND_API_KEY=
# Avisos por email (src/lib/emailAvisos.js): coincidencias altas y el
# "¿Hubo novedades?" a los 30 días. Opcionales — por defecto salen desde
# "Felpus <avisos@felpus.com>" (dominio verificado en Resend) y las
# respuestas van a contacto.felpus@gmail.com. Los links de los mails se
# firman con una clave derivada de SUPABASE_SERVICE_ROLE_KEY.
EMAIL_FROM=
EMAIL_REPLY_TO=
# Mismo valor que guardaste en Supabase Vault con
# vault.create_secret('<tu secreto>', 'notify_webhook_secret') — es lo que
# usa el trigger notify_new_report() (ver schema.sql) para autenticar el
# pedido a este webhook.
NOTIFY_WEBHOOK_SECRET=

# --- Opcional: Google Analytics 4 (2026-08-10, para ver de dónde viene el tráfico) ---
# El Measurement ID de tu propiedad GA4 (analytics.google.com -> Admin ->
# Data Streams -> tu stream web -> "Measurement ID", empieza con "G-"). No es
# secreto (viaja igual en cada pedido del navegador), por eso es NEXT_PUBLIC_.
# Sin esto, el sitio funciona igual — GA4 simplemente no se monta (ver layout.js).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Opcional: Asistente Felpus (chat con IA, /api/chat) ---
# API key de Anthropic (console.anthropic.com -> API Keys). Es SECRETA: nunca
# en una variable NEXT_PUBLIC_ ni en el repo — solo la usa la ruta de
# servidor. Sin esto, el botón del asistente sigue apareciendo pero solo con
# las preguntas frecuentes y los accesos al formulario (sin IA).
# Recomendado: poner un límite de gasto mensual en la consola de Anthropic.
ANTHROPIC_API_KEY=
# Solo si la API responde "This API key is not scoped to a workspace": el ID
# del workspace de Anthropic (console.anthropic.com -> Settings -> Workspaces,
# empieza con "wrkspc_"). No es secreto.
ANTHROPIC_WORKSPACE_ID=
# Opcional: otro modelo para bajar costos (ej. claude-sonnet-5-5 o
# claude-haiku-5-5). Vacío = claude-opus-5-5.
ANTHROPIC_CHAT_MODEL=

# --- Opcional: leer la captura de un aviso con IA (/api/import-post) ---
# API key GRATUITA de Gemini (aistudio.google.com -> Get API key). Es
# SECRETA: nunca en una variable NEXT_PUBLIC_ ni en el repo. Sin esto, el
# botón "Subir captura del aviso" avisa que no está disponible y el formulario
# sigue igual que siempre.
GEMINI_API_KEY=
# Opcional: otro modelo. Vacío = gemini-flash-lite-latest (el de más cupo gratis).
GEMINI_MODEL=

# --- Opcional: alertas automáticas (PLAN-alertas.md) ---
# Usa las mismas claves VAPID de arriba (sin ellas no se manda ningún push).
# Secreto para llamar a /api/alerts/dispatch y /api/alerts/flush. El cron de
# las 8 de Supabase usa NOTIFY_WEBHOOK_SECRET (Vault), así que este es
# opcional: sirve para pruebas manuales. Generalo con
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ALERTS_WEBHOOK_SECRET=
# Umbrales de similitud (0 a 1). >= ALTO: push "Puede ser tu mascota".
# Entre MEDIO y ALTO: se guarda en "Posibles coincidencias" sin push.
MATCH_THRESHOLD_HIGH=
MATCH_THRESHOLD_MID=
